      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pid-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT lat, lon,\n       round(avg_delay_gain_s::numeric) AS delay_gain,\n       trips,\n       from_stop_name || ' -> ' || to_stop_name AS segment,\n       lines\nFROM daily_segment_delays\nWHERE date = '$date' AND lat IS NOT NULL AND avg_delay_gain_s >= 10\nORDER BY avg_delay_gain_s"
        }
      ]
    },
    {
