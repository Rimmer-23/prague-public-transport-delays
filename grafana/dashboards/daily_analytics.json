      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pid-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE route_type WHEN 0 THEN 'tram' WHEN 1 THEN 'metro' WHEN 2 THEN 'train' WHEN 3 THEN 'bus'\n            WHEN 4 THEN 'ferry' WHEN 7 THEN 'funicular' WHEN 11 THEN 'trolleybus' ELSE 'other' END AS vehicle_type,\n       sum(late_share * positions) / nullif(sum(positions), 0) AS \"late 3+ min\"\nFROM daily_line_stats\nWHERE date = '$date'\nGROUP BY 1\nHAVING sum(positions) >= 100\nORDER BY 2 DESC"
        }
      ]
    },
