      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pid-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT line AS \"Line\",\n       CASE route_type WHEN 0 THEN 'tram' WHEN 1 THEN 'metro' WHEN 2 THEN 'train' WHEN 3 THEN 'bus'\n            WHEN 4 THEN 'ferry' WHEN 7 THEN 'funicular' WHEN 11 THEN 'trolleybus' ELSE 'other' END AS \"Type\",\n       route_long_name AS \"Route\",\n       trips AS \"Trips\",\n       avg_delay_s AS \"Avg delay\",\n       p50_delay_s AS \"Median\",\n       p90_delay_s AS \"90th pct\",\n       late_share AS \"Late 3+ min\"\nFROM daily_line_stats\nWHERE date = '$date' AND trips >= $min_trips\nORDER BY avg_delay_s DESC\nLIMIT 25"
        }
      ]
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Share of late positions by vehicle type",
      "description": "Trams vs buses vs trains: share of positions that were 3 minutes or more behind the timetable (vehicle types with fewer than 100 positions that day are hidden).",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 11
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pid-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
