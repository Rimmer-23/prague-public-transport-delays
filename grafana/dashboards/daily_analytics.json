      "options": {
        "xField": "vehicle_type",
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
