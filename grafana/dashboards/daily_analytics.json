{
  "uid": "pid-daily-analytics",
  "title": "PID daily analytics",
  "description": "Results of the daily Spark batch job over the Parquet archive: worst lines, rush hours, trams vs buses, slow segments, impact of disruptions.",
  "tags": [
    "pid"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "Europe/Prague",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "pid"
      ],
      "asDropdown": false,
      "title": "PID dashboards",
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "date",
        "label": "Day",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "pid-postgres"
        },
        "multi": false,
        "includeAll": false,
        "query": "SELECT date::text FROM daily_line_stats GROUP BY date ORDER BY date DESC",
        "refresh": 1,
        "sort": 0
      },
      {
        "name": "min_trips",
        "label": "Lines with at least",
        "type": "custom",
        "multi": false,
        "includeAll": false,
        "query": "5 trips : 5,20 trips : 20,50 trips : 50,100 trips : 100",
        "current": {
          "selected": true,
          "text": "20 trips",
          "value": "20"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Average delay",
      "description": "All vehicle positions of the day, weighted by the number of positions per line.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pid-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pid-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(sum(avg_delay_s::numeric * positions) / nullif(sum(positions), 0)) AS avg_delay\nFROM daily_line_stats\nWHERE date = '$date'"
        }
      ]
    },
