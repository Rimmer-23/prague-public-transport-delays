      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pid-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date::timestamp AT TIME ZONE 'Europe/Prague' AS \"time\",\n       CASE route_type WHEN 0 THEN 'tram' WHEN 1 THEN 'metro' WHEN 2 THEN 'train' WHEN 3 THEN 'bus'\n            WHEN 4 THEN 'ferry' WHEN 7 THEN 'funicular' WHEN 11 THEN 'trolleybus' ELSE 'other' END AS vehicle_type,\n       round(sum(avg_delay_s::numeric * positions) / sum(positions)) AS avg_delay\nFROM daily_line_stats\nWHERE $__timeFilter(date::timestamp AT TIME ZONE 'Europe/Prague') AND route_type IN (0, 2, 3, 11)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
