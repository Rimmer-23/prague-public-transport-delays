    {
      "id": 21,
      "type": "barchart",
      "title": "Average delay by hour and vehicle type",
      "description": "Rush hours of the selected day (Prague time).",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pid-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "hour",
        "orientation": "vertical",
        "showValue": "never",
        "groupWidth": 0.8,
        "barWidth": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pid-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT lpad(hour::text, 2, '0') || ':00' AS hour,\n       round(sum(avg_delay_s::numeric * positions) FILTER (WHERE route_type = 0) / nullif(sum(positions) FILTER (WHERE route_type = 0), 0)) AS tram,\n       round(sum(avg_delay_s::numeric * positions) FILTER (WHERE route_type = 3) / nullif(sum(positions) FILTER (WHERE route_type = 3), 0)) AS bus,\n       round(sum(avg_delay_s::numeric * positions) FILTER (WHERE route_type = 2) / nullif(sum(positions) FILTER (WHERE route_type = 2), 0)) AS train,\n       round(sum(avg_delay_s::numeric * positions) FILTER (WHERE route_type = 11) / nullif(sum(positions) FILTER (WHERE route_type = 11), 0)) AS trolleybus\nFROM hourly_delay_stats\nWHERE date = '$date'\nGROUP BY hour\nORDER BY hour"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Average delay by day",
