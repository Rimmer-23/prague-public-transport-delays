# Copy this file to .env and fill in real values. .env is not committed to git.

# Golemio API token (get it at https://api.golemio.cz/api-keys)
GOLEMIO_API_TOKEN=your-token-here

# Kafka address for programs running on Windows (see docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# How often to poll Golemio API, seconds (keep >= 10 because of API limits)
POLL_INTERVAL_S=20

# How often to poll the PID RSS feeds with disruptions, seconds (the feeds are refreshed every ~3 minutes)
DISRUPTIONS_POLL_INTERVAL_S=120

# Telegram bot for alerts (optional). Create a bot with @BotFather in Telegram (/newbot) and paste its token here.
# Left empty, the bot runs in console mode: alerts are printed instead of sent.
TELEGRAM_BOT_TOKEN=

# PostgreSQL in Docker: aggregates written by Spark, read by Grafana.
# Used when the database is created for the first time; to change later: `docker compose down -v` or ALTER USER.
POSTGRES_DB=pid
POSTGRES_USER=pid
POSTGRES_PASSWORD=change-me

# Grafana (http://localhost:3001). Dashboards are visible without login; to edit, log in as admin.
# The admin password is applied when Grafana starts for the first time (empty volume grafana-data).
GRAFANA_ADMIN_PASSWORD=change-me
# Password of the read-only database role grafana_reader that Grafana uses for queries
GRAFANA_DB_PASSWORD=change-me
