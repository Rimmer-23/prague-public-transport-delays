# Copy this file to .env and fill in real values. .env is not committed to git.

# Golemio API token (get it at https://api.golemio.cz/api-keys)
GOLEMIO_API_TOKEN=your-token-here

# Kafka address for programs running on Windows (see docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# How often to poll Golemio API, seconds (keep >= 10 because of API limits)
POLL_INTERVAL_S=20

# PostgreSQL in Docker: aggregates written by Spark, read by Grafana.
# Used when the database is created for the first time; to change later: `docker compose down -v` or ALTER USER.
POSTGRES_DB=pid
POSTGRES_USER=pid
POSTGRES_PASSWORD=change-me
